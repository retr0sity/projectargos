  speakerName: New Neighbour
  dialogueLines: []
  oneTimeOnly: 1
  triggerID: 
  useConversationMode: 1
  conversationLines:
  - speaker: Demetra
    text: "Hello, I'm Demetra. \nI just moved here."
  - speaker: You
    text: Hello, I'm Persa.
  - speaker: Demetra
    text: 'I''m having a get-together this evening, to celebrate the new place.

      You''re
      very welcome to come if you like!'
  - speaker: You - Persa
    text: 'Thank you for the invitation! I am not sure if I can make it though... '
  - speaker: Demetra
    text: Not a problem! Feel free to pass by if you change your mind!
  - speaker: You - Persa
    text: Thank you.
